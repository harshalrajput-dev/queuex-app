# =============================================
# QueueX environment variables (placeholders only)
# Copy this file to .env and fill real values.
# NEVER commit the real .env file.
# =============================================

PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_secure_secret_at_least_32_chars

# Development OTP mode: true -> OTP is shown in the API response (no SMS gateway needed)
DEV_OTP_MODE=true

# Seed development/test data on first start when collections are empty
SEED_DEV_DATA=true

# Optional: DNS servers used to resolve MongoDB Atlas hostnames
DNS_SERVERS=8.8.8.8,1.1.1.1

# Allowed browser origins for CORS (comma separated). Same-origin + localhost are always allowed.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
